## Local Configuration Template

# Location of the Android SDK.
# sdk.dir=/path/to/Android/Sdk

# API Keys (Required for AI nutritional breakdown and search features)
# Obtain a Gemini API Key from Google AI Studio: https://aistudio.google.com/
gemini_api_key=YOUR_GEMINI_API_KEY_HERE

# (Optional) Tavily Search API Key for web evidence lookup: https://tavily.com/
tavily_api_key=YOUR_TAVILY_API_KEY_HERE

# (Optional) Fish Audio API Key
fish_audio_api_key=YOUR_FISH_AUDIO_API_KEY_HERE

# Release keystore configuration (Optional, for signed release builds)
# release_store_file=release.keystore
# release_store_password=YOUR_KEYSTORE_PASSWORD
# release_key_alias=YOUR_KEY_ALIAS
# release_key_password=YOUR_KEY_PASSWORD
